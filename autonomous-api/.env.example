# Application Settings
APP_NAME=Autonomous Evolution Engine
APP_VERSION=0.1.0
DEBUG=false

# LLM Configuration (Optional - for reasoning features)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OpenAI API Key (optional - if using OpenAI instead of Ollama)
OPENAI_API_KEY=your-api-key-here

# Optional durable SQLite outbox for verified maintenance evidence delivery.
# Use a persistent mounted volume in deployed environments; empty disables status API.
MAINTENANCE_OUTBOX_DB_PATH=

# Security and governed candidate promotion
ENVIRONMENT=development
SECRET_KEY=
ADMIN_API_KEY=
GOVERNANCE_AUDIT_SIGNING_KEY=
GOVERNANCE_ENFORCEMENT_REQUIRED=false

# Separate identities and secrets. Use unique high-entropy values for every principal.
# Production requires all three governance principal groups and enforcement=true.
GOVERNANCE_COUNCIL_API_KEYS={"council-1":"replace-with-unique-secret-1","council-2":"replace-with-unique-secret-2"}
GOVERNANCE_EVALUATOR_API_KEYS={"evaluator-1":"replace-with-unique-evaluator-secret"}
GOVERNANCE_CERTIFIER_ID=certifier-1
GOVERNANCE_CERTIFIER_API_KEY=replace-with-unique-certifier-secret
