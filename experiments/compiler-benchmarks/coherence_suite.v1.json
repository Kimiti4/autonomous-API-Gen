{
  "schema_version": "tiannara.coherence-suite.v1",
  "status": "SPECIFIED_NOT_EXECUTED",
  "purpose": "A measurable, fail-closed suite for coherence across ten application-generation and maintenance domains. This manifest defines evaluation obligations; it is not execution, compiler qualification, or certification evidence.",
  "policy": {
    "iterations_per_application": 2,
    "requires_two_distinct_end_to_end_compilers": true,
    "same_frozen_input_for_both_compilers": true,
    "isolated_workspaces_and_state": true,
    "independent_acceptance_evaluator": true,
    "unknown_is_not_pass": true,
    "simulated_evidence_can_certify": false,
    "critical_security_or_integrity_failure_is_veto": true,
    "human_repair_must_be_logged_and_not_replace_primary_artifact": true
  },
  "shared_gates": [
    "canonical_input_hashes",
    "compiler_identity_and_source_revision",
    "isolated_reproducible_build",
    "requirement_to_artifact_to_test_traceability",
    "unit_integration_contract_and_end_to_end_tests",
    "negative_case_tests",
    "runtime_health_and_readiness",
    "dependency_and_secret_scan",
    "artifact_hash_manifest",
    "independent_evidence_review"
  ],
  "status_vocabulary": [
    "PASS",
    "FAIL",
    "UNKNOWN",
    "BLOCKED",
    "NOT_RUN"
  ],
  "applications": [
    {
      "application_id": "taskflow",
      "name": "Full-stack SaaS / tenancy / RBAC",
      "canonical_problem": "experiments/taskflow-native/PROBLEM.md",
      "acceptance_criteria": "golden-projects/taskflow/ACCEPTANCE.json",
      "focus": [
        "workspace isolation",
        "owner/manager/member permission matrix",
        "project/task/assignee referential integrity",
        "session revocation and expiry",
        "idempotent mutations and unique audit effect identity",
        "archive visibility",
        "API and frontend state contracts"
      ],
      "critical_invariants": [
        "cross-workspace reads and writes are denied",
        "assignees belong to task workspace",
        "owner-only actions reject manager/member roles unless explicitly authorized",
        "revoked sessions cannot authorize subsequent requests",
        "retries do not duplicate declared-idempotent effects",
        "archived resources stay out of active queries"
      ],
      "negative_cases": [
        "cross_workspace_read",
        "cross_workspace_write",
        "unauthorized_role_mutation",
        "foreign_project_task",
        "foreign_workspace_assignee",
        "duplicate_idempotent_effect",
        "invalid_authentication",
        "expired_or_revoked_session"
      ],
      "status": "BLOCKED_TRUSTED_SEMANTIC_REVIEW_AND_LIVE_COMPILER_INTEGRATION"
    },
    {
