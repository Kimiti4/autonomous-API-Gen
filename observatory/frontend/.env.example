# Browser-safe value.
# This may be public because it is used by the browser to reach the backend
# for read-only Observatory data.
NEXT_PUBLIC_OBSERVATORY_API_URL=http://127.0.0.1:8000

# Server-only values.
# Do NOT prefix these with NEXT_PUBLIC_.
OBSERVATORY_BACKEND_URL=http://127.0.0.1:8000
OBSERVATORY_BACKEND_TOKEN=

# Command proxy is disabled unless explicitly enabled.
OBSERVATORY_COMMAND_PROXY_ENABLED=false

# Operator console session secret.
OBSERVATORY_SESSION_SECRET=

# Minimal internal operator passphrase.
# For production, replace this with a real identity provider.
OBSERVATORY_OPERATOR_PASSPHRASE=

# Allowed values: operator, architect, admin
OBSERVATORY_OPERATOR_CLEARANCE=operator
