# Phase 31 — Stratified Calibration Harness configuration.
# Copy to .env and fill in values. All settings are environment-injected
# (env_prefix TIANNARA_); nothing is hardcoded in source.
#
# GitHub publication is OPTIONAL. Leave TIANNARA_GITHUB_TOKEN blank to run the
# harness locally with the LocalRepositoryPublisher (records are still pushed to
# the hash-chained evidence ledger). A token is only required for remote publish.
TIANNARA_GITHUB_TOKEN=

TIANNARA_FALLBACK_OWNER=kimiti4
TIANNARA_FALLBACK_EMAIL=karamos473@gmail.com

TIANNARA_MIN_TEST_PASS_RATE=0.995
TIANNARA_REQUIRE_COMPILATION=true
TIANNARA_REQUIRE_SECURITY_SCAN=false
TIANNARA_MAX_SECURITY_VULNERABILITIES=0

TIANNARA_MAX_CONCURRENCY=5
TIANNARA_VERIFICATION_TIMEOUT_SECONDS=300
TIANNARA_QUARANTINE_DIR=./tiannara-quarantine
TIANNARA_LEDGER_PATH=./tiannara-evidence/calibration-ledger.jsonl
